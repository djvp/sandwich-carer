{# The animated Sam. Five layer groups so he can pop apart; moods are classes
   on the svg (mood-calm / mood-side / mood-over / mood-talk), driven by site.js. #}
<button class="sam-btn" id="samBtn" type="button" aria-label="Tap Sam to see what he does">
<svg id="heroSam" class="sam-hero mood-calm" viewBox="0 0 300 244" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="heroEyeL"><ellipse cx="122" cy="100" rx="14.5" ry="15.5"/></clipPath>
    <clipPath id="heroEyeR"><ellipse cx="178" cy="100" rx="14.5" ry="15.5"/></clipPath>
  </defs>
  <ellipse class="sam-shadow" cx="150" cy="226" rx="104" ry="12" fill="#33291F" opacity=".13"/>
  <g class="sam-bob">
    <g class="sam-squish">
      <g class="l l-top">
        <path d="M52 78 V44 a14 14 0 0 1 14 -14 h168 a14 14 0 0 1 14 14 v34 z" fill="#D99F3A"/>
        <path d="M61 78 V50 a9 9 0 0 1 9 -9 h160 a9 9 0 0 1 9 9 v28 z" fill="#F0C265"/>
        <path d="M76 52 q20 -8 40 0" stroke="#E3B152" stroke-width="4" fill="none" stroke-linecap="round" opacity=".9"/>
      </g>
      <g class="l l-tomato">
        <rect x="46" y="78" width="208" height="58" rx="8" fill="#D95B43"/>
        <rect x="46" y="78" width="208" height="7" rx="3.5" fill="#E2705B"/>
        <rect class="brow brow-l" x="110" y="79" width="24" height="5.5" rx="2.75" fill="#2A211A"/>
        <rect class="brow brow-r" x="166" y="79" width="24" height="5.5" rx="2.75" fill="#2A211A"/>
        <ellipse cx="122" cy="100" rx="14.5" ry="15.5" fill="#FFF6EA"/>
        <ellipse cx="178" cy="100" rx="14.5" ry="15.5" fill="#FFF6EA"/>
        <g clip-path="url(#heroEyeL)"><g class="pupils"><circle cx="122" cy="101" r="6.8" fill="#2A211A"/><circle class="glint" cx="126" cy="96" r="2.4" fill="#FFF6EA"/></g><rect class="lid" x="104" y="82" width="38" height="34" fill="#D95B43"/></g>
        <g clip-path="url(#heroEyeR)"><g class="pupils"><circle cx="178" cy="101" r="6.8" fill="#2A211A"/><circle class="glint" cx="182" cy="96" r="2.4" fill="#FFF6EA"/></g><rect class="lid" x="160" y="82" width="38" height="34" fill="#D95B43"/></g>
        <path class="mouth m-calm" d="M136 120 q14 13 28 0" stroke="#2A211A" stroke-width="4.5" fill="none" stroke-linecap="round"/>
        <path class="mouth m-side" d="M137 123 h26" stroke="#2A211A" stroke-width="4.5" fill="none" stroke-linecap="round"/>
        <path class="mouth m-over" d="M136 127 q14 -12 28 0" stroke="#2A211A" stroke-width="4.5" fill="none" stroke-linecap="round"/>
        <ellipse class="mouth m-talk" cx="150" cy="122" rx="10" ry="7.5" fill="#2A211A"/>
      </g>
      <g class="l l-lettuce">
        <path d="M38 136 H262 v10 q-14 13 -28 1 q-14 -12 -28 1 q-14 13 -28 1 q-14 -12 -28 1 q-14 13 -28 1 q-14 -12 -28 1 q-14 12 -26 -1 z" fill="#3E8E7E"/>
        <path d="M38 136 H262 v5 H38 z" fill="#4CA189"/>
      </g>
      <g class="l l-cheese">
        <rect x="44" y="156" width="212" height="13" rx="3" fill="#F2C063"/>
        <rect x="248" y="153" width="19" height="19" rx="2.5" fill="#F2C063" transform="rotate(38 257 162)"/>
      </g>
      <g class="l l-bottom">
        <path d="M52 169 h196 v26 a14 14 0 0 1 -14 14 H66 a14 14 0 0 1 -14 -14 z" fill="#D99F3A"/>
        <path d="M61 169 h178 v22 a9 9 0 0 1 -9 9 H70 a9 9 0 0 1 -9 -9 z" fill="#F0C265"/>
      </g>
    </g>
  </g>
</svg>
</button>
