{# One guide for sale. Expects `g` (an entry from src/_data/guides.json). #}
{%- set cat = categories[g.category] -%}
{%- set buyUrl = g.url or site.links.shop -%}
<article class="guide" data-topic="{{ g.category }}">
  <div class="cover" style="background:{{ cat.color }}"><svg viewBox="0 0 160 200" aria-hidden="true"><use href="#guideDoc"/></svg></div>
  <div class="body">
    <div class="guide-tags"><span class="topic"><span class="dot" style="background:{{ cat.color }}" aria-hidden="true"></span>{{ cat.label }}</span><span class="fmt">Fillable PDF</span></div>
    <h3>{{ g.title }}</h3>
    <p>{{ g.blurb }}</p>
    <div class="buy">
      <span class="price">{{ g.price }}{% if g.samplePrice %}<small>SAMPLE PRICE</small>{% endif %}</span>
      <a class="btn btn-primary btn-sm" href="{{ buyUrl or '#' }}"{% if buyUrl %} target="_blank" rel="noopener"{% else %} data-facade="the store"{% endif %}>{{ g.cta }}</a>
    </div>
  </div>
</article>
