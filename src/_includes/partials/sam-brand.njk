    <ellipse cx="122" cy="111" rx="12.5" ry="13.5" fill="none" stroke="#33291F" stroke-width="4"/>
    <ellipse cx="178" cy="111" rx="12.5" ry="13.5" fill="none" stroke="#33291F" stroke-width="4"/>
    <path d="M137 129 q13 11.7 26 0" stroke="#33291F" stroke-width="5" fill="none" stroke-linecap="round"/>
