  <defs>
    <clipPath id="navEyeL"><ellipse cx="122" cy="111" rx="12.5" ry="13.5"/></clipPath>
    <clipPath id="navEyeR"><ellipse cx="178" cy="111" rx="12.5" ry="13.5"/></clipPath>
  </defs>
  <g class="sam-bob">
    <use href="#samBlank"/>
    <rect x="110" y="89" width="24" height="5.5" rx="2.75" fill="#33291F"/>
    <rect x="166" y="89" width="24" height="5.5" rx="2.75" fill="#33291F"/>
