---
layout: layouts/base.njk
title: All tools
description: Every Sandwich Carer guide, checklist, template and script on disability, ageing and mental health, sorted by topic.
permalink: /tools/
---
<main class="archive">
  <div class="wrap">
    <header class="archive-head">
      <a class="back" href="/">← Home</a>
      <p class="eyebrow">Tools</p>
      <h1>Every tool, by topic.</h1>
      <p class="lede">Guides, checklists, templates and scripts you can fill in on screen, save and print. Buy once, download, keep. No subscription, no account. Prices shown are placeholders until the store is live.</p>
      <div class="filter" data-filter role="group" aria-label="Filter tools by topic">
        <button type="button" class="chip" data-topic="all" aria-pressed="true">All <span class="count">{{ tools | length }}</span></button>
        {% for key, c in categories %}<button type="button" class="chip" data-topic="{{ key }}" aria-pressed="false"><span class="dot" style="background:{{ c.color }}" aria-hidden="true"></span>{{ c.label }} <span class="count">{{ tools | inCategory(key) | length }}</span></button>{% endfor %}
      </div>
    </header>
    <div class="guides" data-filter-items>
      {% for t in tools %}{% include "partials/tool-card.njk" %}{% endfor %}
    </div>
    <p class="archive-help">Questions about a tool or a purchase? <a href="{{ ('mailto:' + site.contact) if site.contact else '#' }}"{% if not site.contact %} data-facade="the contact email"{% endif %}>Email us</a>.</p>
  </div>
</main>
